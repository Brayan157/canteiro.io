# Copy this file to .env and replace the password before starting Docker Compose.
POSTGRES_DB=canteiro
POSTGRES_USER=canteiro
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
APP_PORT=8081
JWT_SECRET=replace-with-a-random-secret-with-at-least-32-characters
BOOTSTRAP_PLATFORM_OWNER_ENABLED=false
BOOTSTRAP_PLATFORM_OWNER_EMAIL=owner@canteiro.local
BOOTSTRAP_PLATFORM_OWNER_PASSWORD=replace-with-a-strong-local-password
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@canteiro.local
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
ASAAS_ENABLED=false
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=canteiro.io/0.0.1 (Java 21; sandbox)
ASAAS_WEBHOOK_ZONE=America/Sao_Paulo
