{
  "info": {"name":"Canteiro — Fase 3","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"apiVersion","value":"/api/v1"}],
  "event": [{"listen":"prerequest","script":{"exec":["pm.environment.set('customerDocument', '99' + Date.now().toString().slice(-9));"]}}],
  "item": [
    {"name":"01 — Autenticação","item":[
      {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}{{apiVersion}}/auth/login","host":["{{baseUrl}}"],"path":["{{apiVersion}}","auth","login"]},"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"}},"event":[{"listen":"test","script":{"exec":["const j = pm.response.json();","pm.environment.set('accessToken', j.accessToken);","pm.environment.set('refreshToken', j.refreshToken);"]}}]}
    ]},
    {"name":"02 — Cliente final","item":[
      {"name":"Criar cliente final (alçada direta ou pendência)","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}{{apiVersion}}/company/customers","body":{"mode":"raw","raw":"{\n  \"customerType\": \"INDIVIDUAL\",\n  \"name\": \"Cliente Fase 3\",\n  \"document\": \"{{customerDocument}}\",\n  \"contacts\": [{\"name\":\"Contato principal\",\"email\":\"contato@example.com\",\"phone\":\"11999999999\",\"primaryContact\":true}],\n  \"addresses\": [{\"label\":\"Principal\",\"postalCode\":\"01311000\",\"street\":\"Av. Paulista\",\"number\":\"100\",\"city\":\"São Paulo\",\"state\":\"SP\",\"country\":\"BR\",\"primaryAddress\":true}],\n  \"justification\": \"Cadastro para teste da Fase 3\"\n}"}},"event":[{"listen":"test","script":{"exec":["const j = pm.response.json();","if (j.customer && j.customer.id) pm.environment.set('customerId', j.customer.id);","if (j.changeRequestId) pm.environment.set('changeRequestId', j.changeRequestId);"]}}]},
      {"name":"Consultar cliente final","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"GET","url":"{{baseUrl}}{{apiVersion}}/company/customers/{{customerId}}"}}
    ]},
    {"name":"03 — Obra","item":[
      {"name":"Criar obra","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}{{apiVersion}}/company/works","body":{"mode":"raw","raw":"{\n  \"finalCustomerId\": \"{{customerId}}\",\n  \"name\": \"Obra Fase 3\",\n  \"reference\": \"OBRA-003\",\n  \"executionLocationType\": \"FINAL_CUSTOMER_LOCATION\",\n  \"status\": \"DRAFT\",\n  \"startedOn\": \"2026-08-18\",\n  \"expectedCompletionOn\": \"2027-02-28\"\n}"}},"event":[{"listen":"test","script":{"exec":["const j = pm.response.json();","if (j.work && j.work.id) pm.environment.set('workId', j.work.id);","if (j.changeRequestId) pm.environment.set('changeRequestId', j.changeRequestId);"]}}]},
      {"name":"Consultar obra","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"GET","url":"{{baseUrl}}{{apiVersion}}/company/works/{{workId}}"}}
    ]},
    {"name":"04 — Contrato","item":[
      {"name":"Criar contrato sem serviço","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}{{apiVersion}}/company/contracts","body":{"mode":"raw","raw":"{\n  \"workId\": \"{{workId}}\",\n  \"reference\": \"CTR-003\",\n  \"name\": \"Contrato inicial Fase 3\",\n  \"status\": \"DRAFT\",\n  \"startedOn\": \"2026-08-18\",\n  \"expectedCompletionOn\": \"2027-02-28\"\n}"}},"event":[{"listen":"test","script":{"exec":["const j = pm.response.json();","if (j.contract && j.contract.id) pm.environment.set('contractId', j.contract.id);","if (j.changeRequestId) pm.environment.set('changeRequestId', j.changeRequestId);"]}}]},
      {"name":"Consultar contrato","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"GET","url":"{{baseUrl}}{{apiVersion}}/company/contracts/{{contractId}}"}}
    ]},
    {"name":"05 — Funcionários","item":[
      {"name":"Cadastrar funcionário sem acesso","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}{{apiVersion}}/company/employees","body":{"mode":"raw","raw":"{\n  \"fullName\": \"Ana da Silva\",\n  \"jobTitle\": \"Montadora\",\n  \"phone\": \"11999999999\"\n}"}},"event":[{"listen":"test","script":{"exec":["const j = pm.response.json();","if (j.employee && j.employee.id) pm.environment.set('employeeId', j.employee.id);","if (j.changeRequestId) pm.environment.set('changeRequestId', j.changeRequestId);"]}}]},
      {"name":"Consultar funcionário","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"GET","url":"{{baseUrl}}{{apiVersion}}/company/employees/{{employeeId}}"}},
      {"name":"Convidar funcionário para acesso","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}{{apiVersion}}/company/employees/{{employeeId}}/access-invitations","body":{"mode":"raw","raw":"{\n  \"email\": \"ana.silva@example.com\"\n}"}},"event":[{"listen":"test","script":{"exec":["if (pm.response.code === 201) pm.environment.set('employeeUserId', pm.response.json().userId);"]}}]}
    ]},
    {"name":"06 — Aprovação","item":[
      {"name":"Aprovar pendência","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}{{apiVersion}}/company/change-requests/{{changeRequestId}}/approve","body":{"mode":"raw","raw":"{\n  \"decisionReason\": \"Aprovado no teste da Fase 3\"\n}"}}},
      {"name":"Rejeitar pendência","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}{{apiVersion}}/company/change-requests/{{changeRequestId}}/reject","body":{"mode":"raw","raw":"{\n  \"decisionReason\": \"Rejeitado no teste da Fase 3\"\n}"}}}
    ]}
  ]
}
